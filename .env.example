# Copy to .env (git-ignored) or export these variables in your shell.
# MemBud reads credentials from the process environment only; it does not load
# this file automatically.

# Primary provider 1: Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Alternative Claude model: claude-sonnet-4-5-20250929
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_CACHE_PATH=~/.cache/membud/claude-cache.sqlite3

# Primary provider 2: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternative Gemini model: gemini-2.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_CACHE_PATH=~/.cache/membud/gemini-cache.sqlite3

# OpenRouter provider (OpenAI-compatible; zero-price guard enforced unless --allow-paid)
# Verified 2026-11-21 against https://openrouter.ai/api/v1/models: the requested
# deepseek/deepseek-v4.1-flash slug exists but is PAID (~$0.05/$0.20 per Mtok);
# no zero-priced DeepSeek V4.1 Flash variant exists. The selected $0 model is
# inclusionai/ling-3.2-flash:free (prompt=completion=request=0; supports
# response_format/structured_outputs). Fallback: baidu/ernie-5.5-flash-preview:free.
# Results are model-dependent; record the resolved slug with any run.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CACHE_PATH=~/.cache/membud/openrouter-cache.sqlite3

# Legacy providers retained for archival artifact reproduction
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CACHE_PATH=~/.cache/membud/deepseek-cache.sqlite3
#
# CMD_API_KEY=
# CMD_MODEL=deepseek/deepseek-v4.1-flash
# CMD_BASE_URL=https://api.commandcode.ai/provider/v1
# CMD_CACHE_PATH=~/.cache/membud/commandcode-cache.sqlite3
