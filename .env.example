# Copy to .env (git-ignored) or export these variables in your shell.
# MemBud reads credentials from the process environment only; it does not load
# this file automatically.

# Primary provider 1: Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Alternative Claude model: claude-sonnet-4-5-20250929
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_CACHE_PATH=~/.cache/membud/claude-cache.sqlite3

# Primary provider 2: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternative Gemini model: gemini-2.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_CACHE_PATH=~/.cache/membud/gemini-cache.sqlite3

# Legacy providers retained for archival artifact reproduction
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CACHE_PATH=~/.cache/membud/deepseek-cache.sqlite3
