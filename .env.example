# Copy to .env (git-ignored) or export these variables in your shell.
# MemBud reads credentials from the process environment only; it does not load
# this file automatically.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CACHE_PATH=~/.cache/membud/deepseek-cache.sqlite3

CMD_API_KEY=
CMD_MODEL=deepseek/deepseek-v4.1-flash
CMD_BASE_URL=https://api.commandcode.ai/provider/v1
CMD_CACHE_PATH=~/.cache/membud/commandcode-cache.sqlite3
