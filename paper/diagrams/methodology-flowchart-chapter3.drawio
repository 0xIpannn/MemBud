" height="66" as="geometry" /></mxCell><mxCell id="nowrite" value="End (no write)" style="shape=mxgraph.flowchart.terminator;strokeWidth=2;fillColor=#fbeaea;strokeColor=#b23b3b;fontColor=#7a2222;html=1;whiteSpace=wrap;strokeColor=#2b3a4a;fontColor=#2b3a4a;" vertex="1" parent="1"><mxGeometry x="20" y="585" width="200" height="44" as="geometry" /></mxCell><mxCell id="build" value="Build canonical transition T = (B, C, E, R, O)&lt;br&gt;and two renderings of the same facts: graph G, text Z" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#f5f7fa;strokeColor=#2b3a4a;fontColor=#2b3a4a;html=1;whiteSpace=wrap;strokeColor=#2b3a4a;fontColor=#2b3a4a;" vertex="1" parent="1"><mxGeometry x="250" y="578" width="280" height="62" as="geometry" /></mxCell><mxCell id="verify" value="Verifier arm (graph or text; rules or LLM)&lt;br&gt;coverage, preservation, faithfulness (+ semantic)" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#f5f7fa;strokeColor=#2b3a4a;fontColor=#2b3a4a;html=1;whiteSpace=wrap;strokeColor=#2b3a4a;fontColor=#2b3a4a;" vertex="1" parent="1"><mxGeometry x="250" y="656" width="280" height="62" as="geometry" /></mxCell><mxCell id="pass" value="All required&lt;br&gt;checks PASS?" style="rhombus;strokeWidth=2;html=1;whiteSpace=wrap;strokeColor=#2b3a4a;fontColor=#2b3a4a;fillColor=#f5f7fa;" vertex="1" parent="1"><mxGeometry x="310" y="740" width="160" height="74" as="geometry" /></mxCell><mxCell id="accept" value="ACCEPT&lt;br&gt;append audit entry;&lt;br&gt;atomic write (temp, fsync, rename), version + 1" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#e8f2e8;strokeColor=#2e7d32;fontColor=#1e5422;html=1;whiteSpace=wrap;strokeColor=#2b3a4a;fontColor=#2b3a4a;" vertex="1" parent="1"><mxGeometry x="100" y="900" width="260" height="76" as="geometry" /></mxCell><mxCell id="hold" value="HOLD&lt;br&gt;append audit entry; no write; store unchanged" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillCo