<mxfile host="app.diagrams.net" type="device"><diagram name="Chapter 3 - verify and commit" id="membud-ch3-flow"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="g_host" value="Host memory system" style="rounded=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#8a8a8a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#555555;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="790" height="150" as="geometry" /></mxCell><mxCell id="g_membud" value="MemBud pre-commit safety layer (gate-only mode)" style="rounded=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#8a8a8a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#555555;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="790" height="650" as="geometry" /></mxCell><mxCell id="g_store" value="Guarded store and append-only audit log" style="rounded=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#8a8a8a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#555555;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="865" width="790" height="150" as="geometry" /></mxCell><mxCell id="start" value="Start" style="shape=mxgraph.flowchart.terminator;strokeWidth=2;html=1;whiteSpace=wrap;strokeColor=#2b3a4a;fontColor=#2b3a4a;" vertex="1" parent="1"><mxGeometry x="330" y="78" width="120" height="42" as="geometry" /></mxCell><mxCell id="host" value="Host proposes a memory update&lt;br&gt;(prior state + evidence + operations)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=0.15;strokeWidth=2;html=1;whiteSpace=wrap;strokeColor=#2b3a4a;fontColor=#2b3a4a;" vertex="1" parent="1"><mxGeometry x="250" y="138" width="280" height="52" as="geometry" /></mxCel